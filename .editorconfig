root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.d]
indent_style = space
indent_size = 4
max_line_length = 120
dfmt_brace_style = otbs
dfmt_soft_max_line_length = 100
dfmt_keep_line_breaks = true

[*.{py,lua}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
