-- Quality metadata. Values live in the keyed relation quality(entity, name, value).
-- Trust runs 0-5 for each hero; the village has morale, food and lamp-oil.

quality.define(:trust,  {initial = 1, minimum = 0, maximum = 5,   label = "Trust"})
quality.define(:oil,    {initial = 60, minimum = 0, maximum = 400, label = "Lamp-oil"})
quality.define(:morale, {initial = 6, minimum = 0, maximum = 10,  label = "Morale"})
quality.define(:food,   {initial = 8, minimum = 0, maximum = 10,  label = "Food"})
quality.define(:night,  {initial = 1, minimum = 1, maximum = 4,   label = "Night", visible = false})

-- Display labels: templates show these for symbols (and the catalog extracts each one).
narrative.name(:ilse, "Ilse")
narrative.name(:corvin, "Corvin")
narrative.name(:wren, "Wren")
narrative.name(:warden, "the Warden")
narrative.name(:lantern, "the Lantern")
narrative.name(:bellfrey, "the Bellfrey")
narrative.name(:mill, "the Mill")
narrative.name(:terraces, "the terraces")
narrative.name(:overlook, "the Valley Overlook")
narrative.name(:bolt, "Bolt lamp")
narrative.name(:chime, "Chime lamp")
narrative.name(:hoar, "Hoar lamp")
narrative.name(:arc, "Arc lamp")
narrative.name(:beacon, "Beacon")
