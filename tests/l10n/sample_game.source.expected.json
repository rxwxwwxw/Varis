{"format":1,"package":"saltmarsh","language":"en","messages":[
 {"key":"saved.title","text":"The Ellen May","revision":"eb3de89e1c696c2d","owner":"storylet saved","field":"title","file":"content/endings.varis","when":"flag(:ship_saved)"},
 {"key":"saved.text","text":"At dawn a battered schooner limps into the channel, her crew waving at the tower.\n{#if query told(:storm)}Hesketh weeps openly. You kept your promise.{/if}","revision":"16979609fc3d6974","owner":"storylet saved","field":"text","file":"content/endings.varis","conditions":["told"],"when":"flag(:ship_saved)"},
 {"key":"saved.fin.title","text":"The end","revision":"0ee2fd54fc2d6849","owner":"choice saved.fin","field":"title","file":"content/endings.varis"},
 {"key":"wrecked.title","text":"Wreckage","revision":"402ba2dc7d3a8198","owner":"storylet wrecked","field":"title","file":"content/endings.varis","when":"flag(:ship_wrecked)"},
 {"key":"wrecked.text","text":"In the morning the shore is strewn with timber. The lamp was dark.","revision":"e0b05ed806c64d25","owner":"storylet wrecked","field":"text","file":"content/endings.varis","when":"flag(:ship_wrecked)"},
 {"key":"wrecked.fin.title","text":"The end","revision":"0ee2fd54fc2d6849","owner":"choice wrecked.fin","field":"title","file":"content/endings.varis"},
 {"key":"gave_up.title","text":"Too much","revision":"6f4bafc272c45a26","owner":"storylet gave_up","field":"title","file":"content/endings.varis","when":"flag(:broken), not flag(:ship_saved), not flag(:ship_wrecked)"},
 {"key":"gave_up.text","text":"You walk inland and do not look back at the tower.","revision":"c266afca2e678d69","owner":"storylet gave_up","field":"text","file":"content/endings.varis","when":"flag(:broken), not flag(:ship_saved), not flag(:ship_wrecked)"},
 {"key":"gave_up.fin.title","text":"The end","revision":"0ee2fd54fc2d6849","owner":"choice gave_up.fin","field":"title","file":"content/endings.varis"},
 {"key":"look.title","text":"Look around {room}","revision":"d8c54c9bc9751d5c","owner":"storylet look","field":"title","file":"content/explore.varis","arguments":["room"],"when":"at(:player, ?room)"},
 {"key":"look.text","text":"You are in {room}.\n{#if query outdoors(room)}{#variant 3}A cold wind comes off the marsh.{#variant 1}Gulls wheel and scream overhead.{#variant 1}Fog lies flat on the water.{/variant}{/if}\n{#if query night()}It is dark.{#else}It is daytime.{/if}\n{#if query lamp_danger()}The lamp gutters. The oil is nearly gone.{/if}","revision":"4624198a53f0343b","owner":"storylet look","field":"text","file":"content/explore.varis","arguments":["room"],"conditions":["outdoors","night","lamp_danger"],"when":"at(:player, ?room)"},
 {"key":"look.wait.title","text":"Wait a while","revision":"0c8c265f2e7a3202","owner":"choice look.wait","field":"title","file":"content/explore.varis","when":"quality(:player, :resolve, ?r), ?r >= 1"},
 {"key":"walk.title","text":"Go to {to}","revision":"156196bba456e277","owner":"storylet walk","field":"title","file":"content/explore.varis","arguments":["to"],"when":"at(:player, ?from), open_exit(?from, ?to)"},
 {"key":"walk.go.title","text":"Go","revision":"08953907b53f670b","owner":"choice walk.go","field":"title","file":"content/explore.varis"},
 {"key":"locked_door.title","text":"A locked door leads to {to}","revision":"267dabc372f7f38d","owner":"storylet locked_door","field":"title","file":"content/explore.varis","arguments":["to"],"when":"at(:player, ?from), locked(?from, ?to)"},
 {"key":"locked_door.text","text":"The door is iron-banded and locked.","revision":"eb957f2b9dbcfcdd","owner":"storylet locked_door","field":"text","file":"content/explore.varis","when":"at(:player, ?from), locked(?from, ?to)"},
 {"key":"locked_door.unlock.title","text":"Unlock it with {key}","revision":"778d15ce5357bb49","owner":"choice locked_door.unlock","field":"title","file":"content/explore.varis","arguments":["key"],"when":"unlocks(?key, ?from, ?to), carries(:player, ?key)"},
 {"key":"locked_door.force.title","text":"Put your shoulder to it","revision":"5e247d64ea2d9c7d","owner":"choice locked_door.force","field":"title","file":"content/explore.varis","when":"quality(:player, :resolve, ?r), ?r >= 8"},
 {"key":"take.title","text":"Pick up {thing}","revision":"380e98b7f01c703f","owner":"storylet take","field":"title","file":"content/explore.varis","arguments":["thing"],"when":"at(:player, ?room), at(?thing, ?room), item(?thing)"},
 {"key":"take.take.title","text":"Take it","revision":"d2b3c0499c0171ff","owner":"choice take.take","field":"title","file":"content/explore.varis","when":"load(:player, ?kg),\n            item_weight(?thing, ?w),\n            where(?kg + ?w <= 8)"},
 {"key":"drop.title","text":"Put down {thing}","revision":"f640aaf655567688","owner":"storylet drop","field":"title","file":"content/explore.varis","arguments":["thing"],"when":"at(:player, ?room), carries(:player, ?thing)"},
 {"key":"drop.drop.title","text":"Put it down","revision":"81dac876b9a8e805","owner":"choice drop.drop","field":"title","file":"content/explore.varis"},
 {"key":"rest.title","text":"Sleep by the stove","revision":"93ac4836cc433b5b","owner":"storylet rest","field":"title","file":"content/explore.varis","when":"at(:player, :cottage), not night()"},
 {"key":"rest.text","text":"An hour's sleep would steady you.","revision":"6081760bfdbca460","owner":"storylet rest","field":"text","file":"content/explore.varis","when":"at(:player, :cottage), not night()"},
 {"key":"rest.sleep.title","text":"Sleep","revision":"3d5dd56be3296048","owner":"choice rest.sleep","field":"title","file":"content/explore.varis"},
 {"key":"go_shopping.title","text":"Browse the stalls","revision":"25aa4a1a31a4299f","owner":"storylet go_shopping","field":"title","file":"content/explore.varis","when":"at(:player, :market)"},
 {"key":"go_shopping.text","text":"Fishwives and chandlers call their wares.","revision":"c4b047db950e4614","owner":"storylet go_shopping","field":"text","file":"content/explore.varis","when":"at(:player, :market)"},
 {"key":"go_shopping.browse.title","text":"Browse","revision":"5e72c12b3367ac87","owner":"choice go_shopping.browse","field":"title","file":"content/explore.varis"},
 {"key":"talk_keeper.title","text":"Talk to old Hesketh","revision":"5f98c295db88e3c9","owner":"storylet talk_keeper","field":"title","file":"content/explore.varis","when":"at(:player, ?room), at(:keeper, ?room)"},
 {"key":"talk_keeper.text","text":"Old Hesketh looks up from his pipe.","revision":"bca8b19badc84747","owner":"storylet talk_keeper","field":"text","file":"content/explore.varis","when":"at(:player, ?room), at(:keeper, ?room)"},
 {"key":"talk_keeper.talk.title","text":"Sit down beside him","revision":"11e9536419d3bdc3","owner":"choice talk_keeper.talk","field":"title","file":"content/explore.varis"},
 {"key":"topic_lamp.title","text":"Ask about the lamp","revision":"1f4bc0cc641ee72e","owner":"storylet topic_lamp","field":"title","file":"content/keeper.varis","when":"not told(:lamp)"},
 {"key":"topic_lamp.text","text":"\"Six measures of oil a night, lad. Less and she goes dark before dawn.\"","revision":"3235f6971abd3e1c","owner":"storylet topic_lamp","field":"text","file":"content/keeper.varis","when":"not told(:lamp)"},
 {"key":"topic_lamp.nod.title","text":"Nod","revision":"215ae619258eba7a","owner":"choice topic_lamp.nod","field":"title","file":"content/keeper.varis"},
 {"key":"topic_key.title","text":"Ask why the lamp room is locked","revision":"e23f622863870f60","owner":"storylet topic_key","field":"title","file":"content/keeper.varis","when":"told(:lamp), not told(:key), quality(:keeper, :trust, ?t), ?t >= 1"},
 {"key":"topic_key.text","text":"He fishes in his coat. \"My knees can't manage the stair. Take this.\"","revision":"cbcf82a3cee6ca36","owner":"storylet topic_key","field":"text","file":"content/keeper.varis","when":"told(:lamp), not told(:key), quality(:keeper, :trust, ?t), ?t >= 1"},
 {"key":"topic_key.accept.title","text":"Take the key","revision":"3477142ad447640a","owner":"choice topic_key.accept","field":"title","file":"content/keeper.varis"},
 {"key":"topic_key.refuse.title","text":"\"I'm not ready.\"","revision":"6e9e2ac6819cf9c9","owner":"choice topic_key.refuse","field":"title","file":"content/keeper.varis"},
 {"key":"topic_storm.title","text":"Tell him about the falling glass","revision":"760bc3ddfdc5abc1","owner":"storylet topic_storm","field":"title","file":"content/keeper.varis","when":"knows(:storm), not told(:storm)"},
 {"key":"topic_storm.text","text":"His face goes grey. \"Then the lamp must burn all that night, whatever it costs.\"","revision":"6c92476af1819824","owner":"storylet topic_storm","field":"text","file":"content/keeper.varis","when":"knows(:storm), not told(:storm)"},
 {"key":"topic_storm.promise.title","text":"\"It will.\"","revision":"3924212b57b2681c","owner":"choice topic_storm.promise","field":"title","file":"content/keeper.varis"},
 {"key":"small_talk.title","text":"Pass the time","revision":"eb25b4a07f0e3730","owner":"storylet small_talk","field":"title","file":"content/keeper.varis","when":"met(:keeper), quality(:keeper, :trust, ?t), ?t < 5"},
 {"key":"small_talk.text","text":"{#variant 1}He talks about wrecks.{#variant 1}He talks about his late wife.{#variant 1}He says nothing, and that is fine.{/variant}","revision":"5f6fcff57798d56e","owner":"storylet small_talk","field":"text","file":"content/keeper.varis","when":"met(:keeper), quality(:keeper, :trust, ?t), ?t < 5"},
 {"key":"small_talk.listen.title","text":"Listen","revision":"dc8acb313473c026","owner":"choice small_talk.listen","field":"title","file":"content/keeper.varis"},
 {"key":"end_talk.title","text":"Get up","revision":"afc4b31fe12a2530","owner":"storylet end_talk","field":"title","file":"content/keeper.varis","when":"met(:keeper)"},
 {"key":"end_talk.bye.title","text":"Leave him to his pipe","revision":"91ecdb419fd2e449","owner":"choice end_talk.bye","field":"title","file":"content/keeper.varis"},
 {"key":"lamp.title","text":"The great lamp","revision":"304a5790041eb489","owner":"storylet lamp","field":"title","file":"content/lamp.varis","when":"at(:player, :lamp_room)"},
 {"key":"lamp.text","text":"The lens is taller than you are.\n{#if query lit(:lamp)}It burns, throwing its beam across the marsh.{#else}It is cold and dark.{/if}","revision":"6117c10777502645","owner":"storylet lamp","field":"text","file":"content/lamp.varis","conditions":["lit"],"when":"at(:player, :lamp_room)"},
 {"key":"lamp.light.title","text":"Strike a match and light it","revision":"b59e3991dbbebbf9","owner":"choice lamp.light","field":"title","file":"content/lamp.varis","when":"not lit(:lamp),\n            carries(:player, :matches),\n            quality(:player, :oil, ?o), ?o > 0"},
 {"key":"lamp.refill.title","text":"Pour in the can of oil","revision":"303ca5525b1868f0","owner":"choice lamp.refill","field":"title","file":"content/lamp.varis","when":"carries(:player, :oil_can), quality(:player, :oil, ?o), ?o <= 2"},
 {"key":"lamp.snuff.title","text":"Snuff it to save oil","revision":"8f59ec743c43d2f6","owner":"choice lamp.snuff","field":"title","file":"content/lamp.varis","when":"lit(:lamp)"},
 {"key":"wares.title","text":"A stall selling {thing}","revision":"07f2e9d8e0f1ef44","owner":"storylet wares","field":"title","file":"content/market.varis","arguments":["thing"],"when":"stock(?thing)"},
 {"key":"wares.text","text":"{#variant 1}The stallholder eyes your purse.{#variant 1}\"Best in Saltmarsh,\" she says.{/variant}","revision":"4086110e66ca392e","owner":"storylet wares","field":"text","file":"content/market.varis","when":"stock(?thing)"},
 {"key":"wares.buy.title","text":"Buy it for {price} coins","revision":"2767cf6a8709e3b0","owner":"choice wares.buy","field":"title","file":"content/market.varis","arguments":["price"],"when":"item_price(?thing, ?price),\n            quality(:player, :coins, ?c),\n            ?c >= ?price,\n            load(:player, ?kg),\n            item_weight(?thing, ?w),\n            where(?kg + ?w <= 8)"},
 {"key":"wares.haggle.title","text":"Plead poverty","revision":"54b0f8d3179e4aac","owner":"choice wares.haggle","field":"title","file":"content/market.varis","when":"quality(:player, :coins, ?c), ?c < 3, quality(:player, :resolve, ?r), ?r >= 1"},
 {"key":"rumour.title","text":"A sailor muttering about a storm","revision":"92c1ba551d6d7bac","owner":"storylet rumour","field":"title","file":"content/market.varis","when":"stock(:spyglass)"},
 {"key":"rumour.text","text":"\"Glass is falling. Big blow coming in three days, mark me.\"","revision":"fff9003c0f76f148","owner":"storylet rumour","field":"text","file":"content/market.varis","when":"stock(:spyglass)"},
 {"key":"rumour.listen.title","text":"Listen","revision":"dc8acb313473c026","owner":"choice rumour.listen","field":"title","file":"content/market.varis"},
 {"key":"leave_market.title","text":"Leave the stalls","revision":"e66432ed5c60cb62","owner":"storylet leave_market","field":"title","file":"content/market.varis","when":"at(:player, :market)"},
 {"key":"leave_market.leave.title","text":"Back to the street","revision":"a89043fd8f0d852f","owner":"choice leave_market.leave","field":"title","file":"content/market.varis"},
 {"key":"quality.coins.label","text":"Coins","revision":"90d8458e3234facd","owner":"quality coins","field":"label","file":"qualities.varis"},
 {"key":"quality.oil.label","text":"Lamp oil","revision":"0c93c563fee2d26f","owner":"quality oil","field":"label","file":"qualities.varis"},
 {"key":"quality.resolve.label","text":"Resolve","revision":"daa890758bf3eca3","owner":"quality resolve","field":"label","file":"qualities.varis"},
 {"key":"quality.trust.label","text":"Keeper's trust","revision":"7f46b9919f687b46","owner":"quality trust","field":"label","file":"qualities.varis"},
 {"key":"quality.day.label","text":"Day","revision":"ca8d3918f4578f1d","owner":"quality day","field":"label","file":"qualities.varis"}
]}
