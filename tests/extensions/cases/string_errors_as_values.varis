-- lib/string reports its errors as values (stage L1); messages are those of the thrown form.
local function msg(f, ...)
    local ok, e = pcall(f, ...)
    assert(not ok)
    return (tostring(e):gsub("^[^:]*:%d+: ", "@: "))
end

assert(msg(string.len) == "bad argument #1 to 'string.len' (string expected, got no value)")
assert(msg(string.sub, "x") == "bad argument #2 to 'string.sub' (number expected, got no value)")
assert(msg(string.rep, "x", 1.5) == "bad argument #2 to 'string.rep' (number has no integer representation)")
assert(msg(string.rep, "xx", 1 << 40):find("resulting string too large", 1, true))
assert(msg(string.char, 256) == "bad argument #1 to 'string.char' (value out of range)")
assert(msg(string.byte, {}) == "bad argument #1 to 'string.byte' (string expected, got table)")
assert(msg(string.find, "a", "(") :find("unfinished capture", 1, true))
assert(msg(string.gsub, "abc", "b", "%2"):find("invalid capture index %2", 1, true))
assert(msg(string.gsub, "abc", "b", "%"):find("invalid use of '%'", 1, true))
assert(msg(string.gsub, "abc", "b", function() return {} end):find("invalid replacement value (a table)", 1, true))
assert(msg(string.gsub, "abc", "b", true) == "bad argument #3 to 'string.gsub' (string/function/table expected, got boolean)")
assert(msg(string.format, "%d") == "bad argument #2 to 'string.format' (no value)")
assert(msg(string.format, "%d", "x") == "bad argument #2 to 'string.format' (number expected, got string)")
assert(msg(string.format, "%y", 1):find("invalid conversion '%y' to 'format'", 1, true))
assert(msg(string.format, "%10q", "a"):find("cannot have modifiers", 1, true))
assert(msg(string.format, "%q", {}) == "bad argument #2 to 'string.format' (value has no literal form)")
assert(msg(string.format, "%10s", "a\0b") == "bad argument #2 to 'string.format' (string contains zeros)")
assert(msg(string.dump, 1) == "bad argument #1 to 'string.dump' (function expected, got number)")
assert(not pcall(string.gmatch("abc", "(b)"), nil) or true)
local it = string.gmatch("abc", "%f")
assert(not pcall(it))
assert(("x"):rep(3, ",") == "x,x,x" and ("abc"):sub(2) == "bc")
