-- lib/string reports its errors as values (stage L1); messages are those of the thrown form.
local function msg(f, ...)
    local ok, e = pcall(f, ...)
    assert(not ok)
    return (tostring(e):gsub("^[^:]*:%d+: ", "@: "))
end

assert(msg(string.len) == "bad argument #1 to 'string.len' (string expected, got no value)")
assert(msg(string.sub, "x") == "bad argument #2 to 'string.sub' (number expected, got no value)")
assert(msg(string.rep, "x", 1.5) == "bad argument #2 to 'string.rep' (number has no integer representation)")
assert(msg(string.rep, "xx", 1 << 40):find("resulting string too large", 1, true))
assert(msg(string.char, 256) == "bad argument #1 to 'string.char' (value out of range)")
assert(msg(string.byte, {}) == "bad argument #1 to 'string.byte' (string expected, got table)")
assert(msg(string.find, "a", "(") :find("unfinished capture", 1, true))
assert(msg(string.gsub, "abc", "b", "%2"):find("invalid capture index %2", 1, true))
assert(msg(string.gsub, "abc", "b", "%"):find("invalid use of '%'", 1, true))
assert(msg(string.gsub, "abc", "b", function() return {} end):find("invalid replacement value (a table)", 1, true))
assert(msg(string.gsub, "abc", "b", true) == "bad argument #3 to 'string.gsub' (string/function/table expected, got boolean)")
assert(msg(string.format, "%d") == "bad argument #2 to 'string.format' (no value)")
assert(msg(string.format, "%d", "x") == "bad argument #2 to 'string.format' (number expected, got string)")
assert(msg(string.format, "%y", 1):find("invalid conversion '%y' to 'format'", 1, true))
assert(msg(string.format, "%10q", "a"):find("cannot have modifiers", 1, true))
assert(msg(string.format, "%q", {}) == "bad argument #2 to 'string.format' (value has no literal form)")
assert(msg(string.format, "%10s", "a\0b") == "bad argument #2 to 'string.format' (string contains zeros)")
assert(msg(string.dump, 1) == "bad argument #1 to 'string.dump' (function expected, got number)")
assert(not pcall(string.gmatch("abc", "(b)"), nil) or true)
local it = string.gmatch("abc", "%f")
assert(not pcall(it))
assert(("x"):rep(3, ",") == "x,x,x" and ("abc"):sub(2) == "bc")

-- utf8 and os (same stage)
assert(msg(utf8.char, -1) == "value out of range")
assert(msg(utf8.char, "x") == "number expected")
assert(msg(utf8.len) == "string expected")
assert(msg(utf8.len, "abc", 10) == "initial position out of bounds")
assert(msg(utf8.len, "abc", 1, 10) == "final position out of bounds")
assert(msg(utf8.codepoint, "\xff") == "invalid UTF-8 code")
assert(msg(utf8.offset, "\xe4\xb8\xad", 1, 2) == "initial position is a continuation byte")
assert(msg(utf8.offset, "abc", 1, 9) == "position out of bounds")
assert(msg(utf8.codes, "\x80") == "invalid UTF-8 code")
assert(utf8.len("héllo") == 5 and utf8.char(0x4e2d) == "\xe4\xb8\xad")
assert(msg(os.date, "%Ez") :find("invalid conversion specifier", 1, true))
assert(msg(os.time, {year = 2000}) == "field 'month' missing in date table")
assert(msg(os.time, {year = "x", month = 1, day = 1}) == "field 'year' is not an integer")
assert(msg(os.difftime) == "bad argument #1 to 'os.difftime' (number expected, got no value)")
assert(msg(os.getenv) == "bad argument #1 to 'os.getenv' (string expected, got no value)")
assert(msg(os.setlocale, "C", "bogus") == "bad argument #2 to 'os.setlocale' (invalid option 'bogus')")
assert(os.time({year = 2000, month = 1, day = 1, hour = 0}) > 0)

-- string.pack family
assert(msg(string.pack, "i17", 1) == "integral size (17) out of limits [1,16]")
assert(msg(string.pack, "q", 1) == "invalid format option 'q'")
assert(msg(string.pack, "c", "a") == "missing size for format option 'c'")
assert(msg(string.pack, "Xc1") == "invalid next option for option 'X'")
assert(msg(string.pack, "!3i4", 1) == "format asks for alignment not power of 2")
assert(msg(string.pack, "b", 200) == "integer overflow")
assert(msg(string.pack, "B", 256) == "unsigned overflow")
assert(msg(string.pack, "c1", "ab") == "string longer than given size")
assert(msg(string.pack, "z", "a\0b") == "string contains zeros")
assert(msg(string.pack, "b", 1.5) == "number has no integer representation")
assert(msg(string.pack, "b", {}) == "number expected")
assert(msg(string.packsize, "s") == "variable-length format")
assert(msg(string.unpack, "i4", "ab") == "data string too short")
assert(msg(string.unpack, "z", "ab") == "unfinished string for format 'z'")
assert(msg(string.unpack, "b", "ab", 5) == "initial position out of string")
assert(msg(string.unpack, "i16", ("\xff"):rep(8) .. ("\x01"):rep(8)) == "16-byte integer does not fit into Lua Integer")
assert(string.unpack("<i2", string.pack("<i2", -2)) == -2 and string.packsize("!i4i8") == 16)
