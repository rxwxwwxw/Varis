local T = dofile((arg[0]:match("^(.*)/") or ".") .. "/harness.varis")
local emit, try = T.emit, T.try
local name = os.tmpname()
local f = assert(io.open(name, "w"))
emit(io.type(f), io.type(io.stdout), io.type(42))
emit(f:write("line one\n", 2, " ", 3.5, "\nlast line without newline"))
emit(f:seek("cur"), f:seek("set", 5), f:seek("end"))
f:close()
emit(io.type(f), pcall(f.write, f, "x"))
for l in io.lines(name) do emit("line", l) end
for a, b in io.lines(name, 1, "n") do emit("pair", a, b) break end
local r = assert(io.open(name))
emit(r:read("l"), r:read("n"), r:read("n"), r:read("L"), r:read(4), r:read("a"), r:read("a"), r:read("l"))
r:seek("set", 0)
emit(r:read(0), r:read(100):len(), r:read(0))
r:close()
-- append mode, read/write mode, buffering calls
local a = assert(io.open(name, "a")); a:write("\nappended"); a:close()
local rw = assert(io.open(name, "r+"))
rw:write("LINE")
rw:seek("set", 0)
emit(rw:read("a"):sub(1, 12), rw:setvbuf("full", 1024), rw:flush())
rw:close()
emit(io.open("/nonexistent/dir/file", "r"))
try(io.open, name, "rz")
try(io.lines, "/nonexistent/file")
-- default input/output redirection
io.output(name)
io.write("redirected ", 1, "\n")
io.close()
io.output(io.stdout)
io.input(name)
emit(io.read("a"))
io.close(io.input())
io.input(io.stdin)
-- binary data round trip
local bf = assert(io.open(name, "wb"))
local bytes = {}
for i = 0, 255 do bytes[#bytes + 1] = string.char(i) end
bf:write(table.concat(bytes)); bf:close()
bf = assert(io.open(name, "rb"))
local data = bf:read("a")
bf:close()
emit(#data, data:byte(1), data:byte(256), data == table.concat(bytes))
emit(os.remove(name), (os.remove(name)))
emit((select(2, os.rename("/nonexistent/a", "/nonexistent/b"))))
-- os library with fixed inputs
emit(os.time{year = 2020, month = 1, day = 1, hour = 12, min = 30, sec = 15, isdst = false} ~= nil)
emit(os.date("!%Y-%m-%d %H:%M:%S", 0), os.date("!%A %B %j %p %y %%", 86400 * 40))
local d = os.date("!*t", 1700000000)
emit(d.year, d.month, d.day, d.hour, d.min, d.sec, d.wday, d.yday, d.isdst)
emit(os.time(os.date("*t", 1700000000)))
try(os.date, "%Ez")
try(os.date, "%Q")
emit(os.getenv("VARIS_SURELY_UNSET_VARIABLE"), type(os.clock()), type(os.tmpname()))
emit(os.difftime(10, 4), math.type(os.difftime(10, 4)))
emit(os.time{year = 2000, month = 14, day = 35, hour = 0} == os.time{year = 2001, month = 3, day = 7, hour = 0})
local norm = {year = 2021, month = 14, day = 35, hour = 25}
os.time(norm)
emit(norm.year, norm.month, norm.day, norm.hour)
emit(os.execute() ~= nil, (os.execute("exit 3")))
emit(select(3, os.execute("exit 3")))
local p = io.popen("echo popen-works", "r")
emit(p:read("l"), select(3, p:close()))
T.done()
