require("sample-vn.content")
local function factory() return logic.emptyworld() end
local session = narrative.new(factory())
session:play(:harbour)
local function next_beat(s, input)
    local p = s:present()
    s:advance(p.token, input)
    return s:present()
end
next_beat(session) -- background
next_beat(session) -- music
next_beat(session) -- show
local welcome = next_beat(session, "Rowan")
assert(welcome.beats[1].text == "Welcome back, Rowan.")
local saved = session:save()
local loaded = narrative.load(saved, factory)
assert(loaded:save() == saved)
local p = loaded:present()
assert(p.scene == :harbour and p.beat_index == 5)
assert(p.locals.visitor == "Rowan")
assert(p.stage.background == :harbour_evening)
assert(p.stage.audio.music == :evening_theme)
assert(p.stage.characters.mira.slot == :left)
assert(p.stage.characters.mira.attributes.expression == :smile)
assert(p.stage.characters.mira.attributes.outfit == :coat)
print(p.beats[1].text)
-- Save inside a called scene as well: the return address is portable.
p = next_beat(loaded)
assert(p.scene == :farewell)
loaded = narrative.load(loaded:save(), factory)
print(loaded:present().beats[1].text)
p = next_beat(loaded)
assert(p.scene == :harbour and p.beat_index == 7)
print(p.beats[1].text)
p = next_beat(loaded)
assert(p.stage.characters.mira.slot == nil)
p = next_beat(loaded)
assert(p.stage.audio.music == nil)
p = next_beat(loaded)
assert(p.beats[1].kind == :ended)
next_beat(loaded)
assert(loaded:present().scene == nil)
print("mid-scene save/load checks passed")
